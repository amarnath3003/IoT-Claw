OPENAI_API_KEY=sk-proj-REPLACE_ME
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
EXECUTION_ENGINE_INTERVAL=5

# ─── RTSP IP Cameras ─────────────────────────────────────────────────────────
# Single camera (primary):
RTSP_CAMERA_URL=rtsp://admin:password@192.168.1.x:554/stream
# Multi-camera (comma-separated) — overrides RTSP_CAMERA_URL when set:
RTSP_CAMERAS=
RTSP_CAMERA_NAMES=front_door
RTSP_CAMERA_LOCATIONS=Entrance

# Local OpenCV detection (no API key required — uses built-in Haar cascades + MOG2)
CAMERA_DETECTION_ENABLED=true
CAMERA_ALERT_COOLDOWN=120
CAMERA_MOTION_SENSITIVITY=500
CAMERA_DETECT_PERSONS=true
CAMERA_DETECT_FACES=true

# Laptop webcam fallback — set to false when using RTSP cameras only
SECURITY_CAMERA_ENABLED=true
# Laptop security camera simulator settings (used when SECURITY_CAMERA_ENABLED=true)
SECURITY_CAMERA_DEVICE_NAME=laptop_security_camera
SECURITY_CAMERA_TOPIC_BASE=simulator/laptop_security_camera
SECURITY_CAMERA_INDEX=0
SECURITY_CAMERA_ALERT_COOLDOWN=60
SECURITY_CAMERA_CAPTURE_DIR=captures

# Telegram Bot API alerts. Create a bot with BotFather, then put your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zigbee2MQTT
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
ZIGBEE2MQTT_ENABLED=true

# ─── Home Assistant Integration ──────────────────────────────────────────────
# Get a Long-Lived Access Token from HA: Profile → Security → Long-Lived Access Tokens
HA_ENABLED=false
HA_HOST=192.168.1.100
HA_PORT=8123
HA_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN_HERE
# Optional: comma-separated domain filter. Leave blank to import ALL entities.
# Example: HA_DOMAIN_FILTER=light,switch,sensor,climate,lock,fan
HA_DOMAIN_FILTER=


AUTONOMOUS_AGENT_ENABLED=true
AUTONOMOUS_AGENT_INTERVAL=60
AUTONOMOUS_AGENT_AGGRESSION=medium
AUTONOMOUS_AGENT_MAX_ACTIONS=3

# Comma-separated list of allowed origins for CORS (needed for LAN/remote access)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173