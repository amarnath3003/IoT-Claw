# IoT-Claw Frontend Configuration
# Copy this file to .env and adjust the values for your deployment.

# The base URL of the backend API (e.g., http://localhost:8000 or https://api.yourdomain.com)
VITE_API_BASE_URL=http://localhost:8000

# The WebSocket URL of the backend (e.g., ws://localhost:8000/ws or wss://api.yourdomain.com/ws)
VITE_WS_URL=ws://localhost:8000/ws
